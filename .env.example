# Copy this file to .env and fill in real values
# .env is git-ignored; .env.example is committed

ANTHROPIC_API_KEY=sk-ant-...

# File paths (relative to project root, or absolute)
DUCKDB_PATH=king_county.duckdb
XGB_HEAT_MODEL_PATH=models/xgb_heat.json
XGB_RISK_MODEL_PATH=models/xgb_risk.json
TF_RISK_MODEL_PATH=models/tf_risk.keras

# CORS origins — keep as ["*"] for internal v1 use
# CORS_ORIGINS=["*"]

# OpenMP thread settings — prevents macOS arm64 conflict between TF and XGBoost
OMP_NUM_THREADS=1
TF_NUM_INTRAOP_THREADS=1
